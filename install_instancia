#!/bin/bash

# reset shell colors
tput init

# https://stackoverflow.com/questions/59895/how-to-get-the-source-directory-of-a-bash-script-from-within-the-script-itself
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do # resolve $SOURCE until the file is no longer a symlink
  PROJECT_ROOT="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$PROJECT_ROOT/$SOURCE" # if $SOURCE was a relative symlink, we need to resolve it relative to the path where the symlink file was located
done
PROJECT_ROOT="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

# required imports
source "${PROJECT_ROOT}"/variables/manifest.sh
source "${PROJECT_ROOT}"/utils/manifest.sh
source "${PROJECT_ROOT}"/lib/manifest.sh

# user configs file
if [[ ! -e "${PROJECT_ROOT}"/config ]]; then
  cat << EOF > "${PROJECT_ROOT}"/config
deploy_password=${deploy_password}
mysql_root_password=${mysql_root_password}
db_pass=${db_pass}
EOF
fi

# this file has passwords
sudo su - root <<EOF
chown root:root "${PROJECT_ROOT}"/config
chmod 700 "${PROJECT_ROOT}"/config
EOF
source "${PROJECT_ROOT}"/config

# interactive CLI
inquiry_options

# Validar dependências antes de continuar
if ! validate_dependencies; then
  printf "${RED} ❌ Dependências faltando. Execute install_primaria primeiro.${GRAY_LIGHT}\n"
  exit 1
fi

# Nota: O usuário deploy é criado automaticamente em get_urls() quando opção 0 é escolhida
# Se outras opções forem escolhidas, o usuário deploy já deve existir (criado pelo install_primaria)

# dependencies related
#system_update
#system_node_install
#system_pm2_install
#system_docker_install
#system_puppeteer_dependencies
#system_snapd_install
#system_nginx_install
#system_certbot_install

# system config
#system_create_user

# backend related
system_git_clone || { printf "${RED} ❌ Erro ao clonar repositório${GRAY_LIGHT}\n"; exit 1; }
backend_set_env || { printf "${RED} ❌ Erro ao configurar variáveis de ambiente do backend${GRAY_LIGHT}\n"; exit 1; }
backend_redis_create || { printf "${RED} ❌ Erro ao criar Redis e PostgreSQL${GRAY_LIGHT}\n"; exit 1; }
backend_node_dependencies || { printf "${RED} ❌ Erro ao instalar dependências do backend${GRAY_LIGHT}\n"; exit 1; }
backend_node_build || { printf "${RED} ❌ Erro ao compilar backend${GRAY_LIGHT}\n"; exit 1; }
backend_db_migrate || { printf "${RED} ❌ Erro ao executar migrações${GRAY_LIGHT}\n"; exit 1; }
backend_db_seed || { printf "${RED} ❌ Erro ao executar seeds${GRAY_LIGHT}\n"; exit 1; }
backend_start_pm2 || { printf "${RED} ❌ Erro ao iniciar PM2 do backend${GRAY_LIGHT}\n"; exit 1; }
backend_nginx_setup || { printf "${RED} ❌ Erro ao configurar nginx do backend${GRAY_LIGHT}\n"; exit 1; }

# frontend related
frontend_set_env || { printf "${RED} ❌ Erro ao configurar variáveis de ambiente do frontend${GRAY_LIGHT}\n"; exit 1; }
frontend_node_dependencies || { printf "${RED} ❌ Erro ao instalar dependências do frontend${GRAY_LIGHT}\n"; exit 1; }
frontend_node_build || { printf "${RED} ❌ Erro ao compilar frontend${GRAY_LIGHT}\n"; exit 1; }
frontend_start_pm2 || { printf "${RED} ❌ Erro ao iniciar PM2 do frontend${GRAY_LIGHT}\n"; exit 1; }
frontend_nginx_setup || { printf "${RED} ❌ Erro ao configurar nginx do frontend${GRAY_LIGHT}\n"; exit 1; }

# network related
#system_nginx_conf
system_nginx_restart || { printf "${RED} ❌ Erro ao reiniciar nginx${GRAY_LIGHT}\n"; exit 1; }
system_certbot_setup || { printf "${YELLOW} ⚠️  Aviso: Problemas ao configurar certificados SSL${GRAY_LIGHT}\n"; }

print_banner
printf "${GREEN} ✅ Instalação concluída com sucesso!${GRAY_LIGHT}\n"
printf "${WHITE} 💻 Instância ${instancia_add} está pronta para uso.${GRAY_LIGHT}\n"
printf "\n"
